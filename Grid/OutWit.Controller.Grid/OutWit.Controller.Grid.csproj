<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.props" />

  <PropertyGroup>
    <ControllerName>Grid</ControllerName>
    <!-- Four parts on purpose: the plugin loader reads this through System.Version, which
         refuses a "-suffix" and would load the module as 1.0.0. -->
    <Version>1.2.0.1</Version>
    <Description>Distributed execution across compute nodes for the WitEngine runtime: Grid.ForEach (fan-out over a collection) and Grid.Delegate (run one activity on the single most-suitable node). Grid.ForEach is fault-tolerant: when a node fails its assigned batch, that node's tasks are reassigned to the remaining healthy nodes and retried instead of failing the whole job; the job fails only when no node can complete the work.</Description>
    <PackageTags>grid;distributed;foreach;delegate;witengine;witcloud;controller</PackageTags>
    <ControllerFeatures>grid-foreach;grid-delegate;grid-replicas</ControllerFeatures>
    <ControllerUseCases>Distributed iteration;Single-node delegation</ControllerUseCases>
  </PropertyGroup>

  <ItemGroup>
    <ControllerDependency Include="Variables" MinimumVersion="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.Grid.Model\OutWit.Controller.Grid.Model.csproj" />
  </ItemGroup>

  <!-- The engine prereleases that carry the replica options and the exact-node request. Grid is
       host-only, so the fleet keeps running 1.1.4. Back to a stable engine before this reaches main. -->
  <ItemGroup>
    <PackageReference Update="OutWit.Engine.Data" Version="1.1.5-replicas.1" />
    <PackageReference Include="OutWit.Engine.Interfaces" Version="1.1.6-replicas.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Consumer-side build/.targets — ships in the nupkg's build/ folder
       and auto-imports into any csproj that PackageReferences this. -->
  <ItemGroup>
    <None Include="build\OutWit.Controller.Grid.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.targets" />

</Project>
