<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Scripts.props" />

  <PropertyGroup>
    <ControllerName>ParaView</ControllerName>
    <Version>0.1.0</Version>
    <Description>Bundled .wit scripts for the OutWit.Controller.Visualization.ParaView controller — RenderParaViewFrames (validate → split into per-timestep tasks with attachment subsets → Grid.ForEach ParaView.RenderFrame → ordered frame set), RenderParaViewStill (one image), RenderParaViewVideo (frames encoded through Render.EncodeVideo; requires the Render controller), and ValidateParaViewScene (the validation report alone, for initiators that preflight a package).</Description>
    <PackageTags>paraview;visualization;scripts;witengine;witcloud;controller</PackageTags>
  </PropertyGroup>

  <!-- Compatibility marker (see docs/adr-001-script-controller-version-compatibility.md):
       these scripts bind to the ParaView controller's 0.x activity surface. -->
  <ItemGroup>
    <PackageReference Include="OutWit.Controller.Visualization.ParaView" Version="[0.1.0, 1.0.0)" />
  </ItemGroup>

  <!-- Source of truth lives next to the ParaView controller. Pack as content so
       consumers receive content/scripts/*.wit on restore; the consumer-side
       build/.targets stages them into bin/@Scripts/. -->
  <ItemGroup>
    <None Include="..\OutWit.Controller.Visualization.ParaView\Scripts\*.wit"
          Pack="true"
          PackagePath="content/scripts/" />

    <None Include="build\OutWit.Controller.Visualization.ParaView.Scripts.targets"
          Pack="true"
          PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.Scripts.targets" />

</Project>
