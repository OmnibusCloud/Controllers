<Project Sdk="Microsoft.NET.Sdk">

  <!--
      A node-like process for the consumer verification (ParaView/RuntimeTools/verify_consumer.sh):
      references ONLY the engine SDK - never a controller assembly - and loads the modules a
      consumer build staged under @Controllers exactly the way the worker node app does
      (WitEngineNode.Reload(useIsolatedContext: false, moduleFolder)), so every controller
      type, including the ParaView runtime resolver's Assembly.Location, comes from the module
      folder. The in-process test suite cannot do that: it references the controller project and
      its bin copy shadows the module's. Not part of the solution; built by the script.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OutWit.Controller.Visualization.ParaView.ConsumerRunner</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OutWit.Engine.Sdk" Version="1.1.6" />
  </ItemGroup>

</Project>
