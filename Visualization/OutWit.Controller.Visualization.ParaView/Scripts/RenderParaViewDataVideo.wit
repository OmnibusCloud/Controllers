Job:RenderParaViewDataVideo(ParaViewDataScene:data, ParaViewOutputOptions:options, VideoOptions:video)
{
    ParaViewSceneRef:scene = Grid.Delegate() => ParaView.Compose(data, options);
    ParaViewValidationReport:report = ParaView.Validate(scene, options);
    ParaViewRenderTaskBatchCollection:tasks = ParaView.SplitBatched(scene, report, options);

    ParaViewRenderResultBatchCollection:rendered = Grid.ForEach(task in tasks)
        => ParaView.RenderFrameBatch(task);

    BlobCollection:frames = ParaView.Collect(rendered, options);
    Blob:result = Render.EncodeVideo(frames, video);
}
