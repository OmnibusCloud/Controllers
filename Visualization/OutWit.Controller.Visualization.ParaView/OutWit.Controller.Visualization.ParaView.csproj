<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <ControllerName>ParaView</ControllerName>
    <Version>0.1.5</Version>
    <Description>Headless scientific visualization: safely executes OmnibusCloud ParaView packages (a saved .pvsm state plus content-addressed data attachments) and distributes independent rendering tasks across worker nodes. ParaView.Validate treats the state as untrusted input (hardened XML parsing, proxy allowlist, programmable-pipeline rejection, logical-path and plugin-requirement checks, size and resolution limits); ParaView.Split produces deterministic tasks per timestep, each carrying only the attachments its timestep needs (per-task attachment subsetting); ParaView.RenderFrame materializes a task's subset into an isolated package root and renders one output through the controller-owned pvpython runner on the software-rendering baseline; ParaView.Collect returns the ordered frame set. The ParaView runtime ships as per-platform Tier-2 assets, never inside the package.</Description>
    <PackageTags>paraview;vtk;visualization;scientific-visualization;headless;osmesa;distributed-rendering;witengine;witcloud;controller</PackageTags>
    <ControllerFeatures>scientific-visualization;paraview-validate;paraview-split;paraview-render-frame;paraview-collect;paraview-collect-still;per-task-attachment-subsetting;software-rendering-baseline</ControllerFeatures>
    <ControllerUseCases>Simulation field rendering;Time-series animation rendering;Slices, contours, glyphs and volume visualization;CalculiX .frd result visualization;Distributed scientific frame rendering</ControllerUseCases>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.Visualization.ParaView.Model\OutWit.Controller.Visualization.ParaView.Model.csproj" />
  </ItemGroup>

  <!-- Direct reference so IWitTempStorage (Engine.Interfaces 1.1.3+) is visible.
       PLAIN MINIMUM, never a wildcard or an exact pin: the module ships no engine
       assemblies — every node's client provides them, and the deployed fleet bundles
       Engine.Interfaces 1.1.4. Restore resolves the LOWEST version satisfying a plain
       minimum, so the compiled reference stays at the fleet's floor while hosts on a
       newer engine still restore (see docs/controller-author-guide.md, "engine
       references and the node fleet", and the Render 1.23.22 incident). -->
  <ItemGroup>
    <PackageReference Include="OutWit.Engine.Interfaces" Version="1.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ControllerDependency Include="Variables" MinimumVersion="1.0.0" />
    <ControllerDependency Include="Grid" MinimumVersion="1.0.0" />
    <ControllerRuntimeTarget Include="win-x64">
      <Rid>win-x64</Rid>
      <Os>windows</Os>
      <Architecture>x64</Architecture>
    </ControllerRuntimeTarget>
    <ControllerRuntimeTarget Include="linux-x64">
      <Rid>linux-x64</Rid>
      <Os>linux</Os>
      <Architecture>x64</Architecture>
    </ControllerRuntimeTarget>
    <ControllerRuntimeTarget Include="osx-arm64">
      <Rid>osx-arm64</Rid>
      <Os>macos</Os>
      <Architecture>arm64</Architecture>
    </ControllerRuntimeTarget>
  </ItemGroup>

  <!--
      ParaView runtime assets: the official ParaView 6.1.1 binaries trimmed to the headless
      pvpython runtime (RuntimeTools/trim_paraview.py; Linux/macOS symlink chains collapsed to
      one SONAME-named file each by collapse_symlinks.py), one zip per platform on the
      paraview-v<ver> GitHub Release, fetched at consumer-build time by OutWit.Engine.Assets'
      ResolveControllerAssetsTask for every RID (build/.targets sets ResolveForAllPlatforms).

      ExtractTo uses the 'windows-x64'/'linux-x64'/'macos-arm64' folder vocabulary that
      ParaViewBinaryResolver reads from paraview.module/paraview/<folder>/; RuntimeIdentifier
      carries the .NET RID the task filters against. PackSource/PackKind are author-only
      (outwit-assets-pack reads @Prerequisites/paraview/<folder>). Sha256/Size are written by
      outwit-assets-pack; the placeholder zeros compile but fail every real fetch, so a release
      cannot be published without running the tool first.

      Linux nodes need the system libraries the runtime does not bundle: libgomp1, libpciaccess0,
      libx11-6, libxext6 (Debian/Ubuntu names; X11 is dlopen'd even for offscreen OSMesa rendering).
      The runtime picks llvmpipe OSMesa through VTK_DEFAULT_OPENGL_WINDOW, which the runner
      environment sets; no GPU, display or system Mesa is required.
  -->
  <ItemGroup>
    <ControllerDataAsset Include="paraview-win-x64">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/paraview-v0.1.0/paraview-windows-x64.zip</Uri>
      <Sha256>4111e02bb72d7dfce6313d2377990f791544d4b569d63a2af8218842bebd5b93</Sha256>
      <Size>247373911</Size>
      <ExtractTo>paraview/windows-x64/</ExtractTo>
      <PackSource>paraview/windows-x64</PackSource>
      <PackKind>zip-folder</PackKind>
    </ControllerDataAsset>
    <ControllerDataAsset Include="paraview-linux-x64">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/paraview-v0.1.0/paraview-linux-x64.zip</Uri>
      <Sha256>879640dce46af0fd834944a73f3a46780bbe9d04b3946cad9638b0f8b8265310</Sha256>
      <Size>411363458</Size>
      <ExtractTo>paraview/linux-x64/</ExtractTo>
      <PackSource>paraview/linux-x64</PackSource>
      <PackKind>zip-folder</PackKind>
    </ControllerDataAsset>
    <ControllerDataAsset Include="paraview-osx-arm64">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/paraview-v0.1.0/paraview-macos-arm64.zip</Uri>
      <Sha256>87f9965210a331c019274945dc173364bc6579025fb6ea99848df5dfc5fac6c6</Sha256>
      <Size>259539063</Size>
      <ExtractTo>paraview/macos-arm64/</ExtractTo>
      <PackSource>paraview/macos-arm64</PackSource>
      <PackKind>zip-folder</PackKind>
    </ControllerDataAsset>
  </ItemGroup>

  <!-- Controller-owned files that are NOT user-supplied and must travel with exactly this
       assembly version: the pvpython task runner, the proxy allowlist tied to the pinned
       runtime version, and — from the reader milestone on — the bundled OmnibusCloud reader
       (byte-identical with the GUI plugin's copy; until then Plugins/ is absent and a package
       requiring the reader is rejected by ParaView.Validate). They are embedded in the controller
       assembly and extracted per task
       into the task's own work directory — the only plugin path the runner consults — so a
       node can never run a stale or foreign copy. Module Resources/ are excluded from the
       nupkg by convention, hence embedding rather than staging. -->
  <ItemGroup>
    <EmbeddedResource Include="Runner\**\*.py" LogicalName="runner/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Allowlists\**\*.json" LogicalName="allowlists/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Plugins\**\*.py" LogicalName="plugins/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Consumer-side build/.targets — ships in the nupkg's build/ folder and
       auto-imports into any csproj that PackageReferences this. -->
  <ItemGroup>
    <None Include="build\OutWit.Controller.Visualization.ParaView.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.targets" />

  <!-- Stage bundled .wit scripts to $(SolutionDir)@Scripts/$(Configuration)/ so the test
       project finds them the same way the Render tests do (FindBundledScriptsPath). -->
  <ItemGroup>
    <ParaViewBundledScript Include="Scripts\*.wit" />
  </ItemGroup>

  <Target Name="ParaViewStageBundledScriptsAtSolutionRoot"
          AfterTargets="ControllerPostBuild"
          Condition="@(ParaViewBundledScript->Count()) &gt; 0">
    <Copy SourceFiles="@(ParaViewBundledScript)"
          DestinationFiles="@(ParaViewBundledScript->'$(SolutionDir)@Scripts\$(Configuration)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
