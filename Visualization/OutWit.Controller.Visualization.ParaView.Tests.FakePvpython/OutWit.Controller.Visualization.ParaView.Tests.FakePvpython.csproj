<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only stand-in for pvpython: honors the runner's host contract
       (pvpython [options] render_task.py with the task file, the task and
       status documents, cwd = package root) so the SDK end-to-end tests can run
       the bundled ParaView scripts through the engine — validate, split, Grid
       dispatch, materialization, output validation, collect — without a ParaView
       runtime. It reads the state like the real runner does and refuses any
       file reference the task did not materialize, which is how the tests prove
       that a task's attachment subset is sufficient. Never packed, never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>fake-pvpython</AssemblyName>
    <RootNamespace>OutWit.Controller.Visualization.ParaView.Tests.FakePvpython</RootNamespace>
  </PropertyGroup>

</Project>
