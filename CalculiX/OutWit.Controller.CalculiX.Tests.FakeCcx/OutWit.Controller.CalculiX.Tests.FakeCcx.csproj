<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only stand-in for the real ccx: honors the bare-jobname contract
       so the SDK end-to-end tests can run the bundled sweep script through
       the engine without a 200 MB solver. Never packed, never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>fake-ccx</AssemblyName>
  </PropertyGroup>

</Project>
