<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Model.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <ControllerName>CalculiX</ControllerName>
    <Version>0.2.0</Version>
    <Description>Shared data types of the CalculiX solve and Sweep orchestration controllers: the per-variant solve task and result, the response-extraction request, and the sweep plan / state / manifest that carry a parameter study through chunked distributed execution. The sweep state and its result index publish a document vocabulary (sweep.state@1) for non-.NET initiators.</Description>
    <PackageTags>calculix;ccx;fem;sweep;parameter-study;witengine;witcloud;controller;data-types</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Publishes the sweep.* document vocabulary (Documents/ committed; CI
         runs the generator in check mode and fails on drift). -->
    <PackageReference Include="OutWit.Cloud.Documents.Generator" Version="1.0.0" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.Model.targets" />

  <!-- A shared model must not stage its deps.json into a module: the client
       install pipeline falls back to inferring the root assembly from THE
       single deps.json it finds, and a second one breaks that inference —
       the exact defect that once froze controller updates fleet-wide.
       Resolution roots at the controller DLL; the model rides as a plain
       dependency. -->
  <Target Name="ModelDropDepsJson" BeforeTargets="ModelPostBuild">
    <ItemGroup>
      <ModelModuleFile Remove="$(TargetDir)$(TargetName).deps.json" />
    </ItemGroup>
  </Target>

  <!-- The Sweep host controller shares these types with the CalculiX node
       controller, so the assembly is staged into BOTH module folders. The
       default ModelPostBuild covers calculix.module; this covers sweep.module.
       Deliberately DLL-only. -->
  <Target Name="ModelPostBuildSweep" AfterTargets="ModelPostBuild">
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll"
          DestinationFolder="$(SolutionDir)@Controllers\$(Configuration)\sweep.module\"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
