<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.props" />

  <PropertyGroup>
    <ControllerName>CalculiX</ControllerName>
    <Version>1.0.1</Version>
    <Description>Runs complete CalculiX (ccx) decks on compute nodes: each solve is one whole deck on one node — the unit of parameter-study throughput. Carries pinned ccx 2.22 builds for every supported node platform as controller assets, so nodes need no preinstalled software; responses are extracted from the result files right on the node.</Description>
    <PackageTags>calculix;ccx;fem;solver;simulation;witengine;witcloud;controller</PackageTags>
    <ControllerFeatures>ccx-solve</ControllerFeatures>
    <ControllerUseCases>Whole-deck CalculiX solves fanned out across a pool; the solve backend of the Sweep parameter-study controller</ControllerUseCases>
  </PropertyGroup>

  <ItemGroup>
    <ControllerDependency Include="Variables" MinimumVersion="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.CalculiX.Model\OutWit.Controller.CalculiX.Model.csproj" />
  </ItemGroup>

  <!-- Pinned ccx builds, one per supported node platform, published by the
       OmnibusCloud/CalculiX repository (which also carries the GPL kit and
       the corresponding-source mirror). Fetched at consumer build time by
       ResolveControllerAssetsTask, never packed into the nupkg.
       Note the two naming vocabularies: RuntimeIdentifier uses RIDs
       (win-x64/osx-arm64), ExtractTo uses the runtime folder names the
       node-side resolver probes (windows-x64/macos-arm64). -->
  <ItemGroup>
    <ControllerDataAsset Include="ccx-win-x64">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/CalculiX/ccx-v2.22-4/ccx-win-x64.zip</Uri>
      <Sha256>4a17f23a62af259406adf5ddf8747566214a063933f845f3c884f76a9540ef5b</Sha256>
      <Size>236881954</Size>
      <ExtractTo>ccx/windows-x64/</ExtractTo>
    </ControllerDataAsset>
    <ControllerDataAsset Include="ccx-linux-x64">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/CalculiX/ccx-v2.22-4/ccx-linux-x64.zip</Uri>
      <Sha256>5e1419bb17b0d9af41fe05d355de66378397ef5cdbb126e09235c2906e0c953b</Sha256>
      <Size>275924987</Size>
      <ExtractTo>ccx/linux-x64/</ExtractTo>
    </ControllerDataAsset>
    <ControllerDataAsset Include="ccx-macos-arm64">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/CalculiX/ccx-v2.22-4/ccx-macos-arm64.zip</Uri>
      <Sha256>24c97cd1049deec8ab41be4dd67d1cf7cb0c7fbb35a21d78858866e15ae3855a</Sha256>
      <Size>3624928</Size>
      <ExtractTo>ccx/macos-arm64/</ExtractTo>
    </ControllerDataAsset>
  </ItemGroup>

  <!-- The benchmark reference deck ships INSIDE the assembly: module
       Resources/ are excluded from the nupkg by design, and the score is
       meaningless if some nodes lack the deck. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\benchmark.inp">
      <LogicalName>benchmark.inp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\OutWit.Controller.CalculiX.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.targets" />

</Project>
