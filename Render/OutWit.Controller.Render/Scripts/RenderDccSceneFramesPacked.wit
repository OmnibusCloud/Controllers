Job:RenderDccSceneFramesPacked(ByteCollection:packedScene, Int:startFrame, Int:endFrame, RenderOptions:options)
{
    DccScene:scene = Render.UnzipDccScene(packedScene);
    Blob:blend = Render.BuildBlendFromDccScene(scene);
    Render.ClearScene(scene);

    RenderTaskBatchCollection:tasks = Render.SplitBatched(blend, startFrame, endFrame, options);

    RenderResultBatchCollection:rendered = Grid.ForEach(task in tasks)
        => Render.FrameBatch(task);

    BlobCollection:result = Render.Collect(rendered, options);
}
