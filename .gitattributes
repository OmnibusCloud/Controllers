
# ParaView fixture corpus: data files are byte-exact (VTK XML with appended binary), states stay LF
Visualization/**/Fixtures/Corpus/data/** -text
Visualization/**/Fixtures/Corpus/states/** text eol=lf
# The embedded runner and the bundled reader are shipped as bytes (the reader byte-identical with the GUI
# plugin's copy) and run under Python on every platform: always LF, whatever the checkout OS
Visualization/**/Runner/*.py text eol=lf
Visualization/**/Plugins/*.py text eol=lf
# Shell scripts run by bash on every platform (git-bash on Windows): always LF
*.sh text eol=lf
# OpenFOAM test cases: dictionaries as OpenFOAM writes them, LF on every checkout
OpenFOAM/**/Fixtures/** text eol=lf
# WebAssembly modules kept as test fixtures: bytes, pinned by hash
*.wasm binary
# Modules the Verify runtime set ships as built (lua.wasm and its licence): bytes, pinned by hash
AI/OutWit.Controller.AI.Verify.Assets/modules/** -text
# Patches the toolchain applies to pinned sources: LF, whatever the checkout OS
*.patch text eol=lf
# The Corpus toolchain (the PDF extractor's crate, its lock file, the build and test scripts): LF on
# every checkout, so a build from a Windows checkout reads the same sources
AI/OutWit.Controller.AI.Corpus.Assets/toolchain/** text eol=lf
# The chess spike (pins, scripts, the golden set): read byte-exact on every runner, always LF
AI/OutWit.Controller.Chess.Spike/** text eol=lf
