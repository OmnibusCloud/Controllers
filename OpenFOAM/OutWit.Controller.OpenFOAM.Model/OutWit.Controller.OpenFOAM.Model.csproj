<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Model.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <ControllerName>OpenFOAM</ControllerName>
    <Version>1.0.1</Version>
    <Description>Shared data types of the OpenFOAM case controller and the rules a case obeys: the case (base files, allow-listed recipe, response request, artifact policy), one variant's run (the case and its token values) and its outcome (per-step exit codes and times, convergence facts, the extracted response row, the artifact reference); the allow-list, recipe grammar, case-path, response and token-coverage rules shared by the node, the Sweep host and client preflight. Consumed by the node controller, the Sweep orchestration controller and client applications.</Description>
    <PackageTags>openfoam;cfd;case;sweep;parameter-study;witengine;witcloud;controller;data-types</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\Build\OutWit.Controller.Model.targets" />

  <!-- A shared model must not stage its deps.json into a module: the client
       install pipeline infers the root assembly from THE single deps.json it
       finds, and a second one breaks that inference (the defect that once
       froze controller updates fleet-wide). Resolution roots at the
       controller DLL; the model rides as a plain dependency. -->
  <Target Name="ModelDropDepsJson" BeforeTargets="ModelPostBuild">
    <ItemGroup>
      <ModelModuleFile Remove="$(TargetDir)$(TargetName).deps.json" />
    </ItemGroup>
  </Target>

  <!-- The Sweep host controller reads these types (an OpenFOAM study's case
       rides inside its options, the node's result inside its manifest rows),
       so the assembly is staged into BOTH module folders. The default
       ModelPostBuild covers openfoam.module; this covers sweep.module.
       Deliberately DLL-only. -->
  <Target Name="ModelPostBuildSweep" AfterTargets="ModelPostBuild">
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll"
          DestinationFolder="$(SolutionDir)@Controllers\$(Configuration)\sweep.module\"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
