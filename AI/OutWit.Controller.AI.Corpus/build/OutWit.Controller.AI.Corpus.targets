<Project>

  <!--
      Consumer-side targets for the OutWit.Controller.AI.Corpus NuGet package.
      Auto-imported into any csproj that PackageReferences this controller.
      Copies the package's content/module/* into the consumer's
      $(OutputPath)@Controllers\corpus.module\ so the controller runtime can
      find the controller DLL and the manifest, then resolves the module's
      Tier-2 data assets (the native wasmtime library per platform and the PDF
      extractor module) from the manifest into the same folder, the way
      Verify's targets do.
  -->

  <PropertyGroup>
    <_OutWitCorpusModulePackageContent>$(MSBuildThisFileDirectory)..\content\module\</_OutWitCorpusModulePackageContent>
    <_OutWitCorpusModuleOutputDir>$(OutputPath)@Controllers\corpus.module\</_OutWitCorpusModuleOutputDir>
  </PropertyGroup>

  <Target Name="OutWitCopyCorpusModule"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="Build"
          Condition="Exists('$(_OutWitCorpusModulePackageContent)')">
    <ItemGroup>
      <_OutWitCorpusFiles Include="$(_OutWitCorpusModulePackageContent)**\*" />
    </ItemGroup>
    <Copy
        SourceFiles="@(_OutWitCorpusFiles)"
        DestinationFiles="@(_OutWitCorpusFiles->'$(_OutWitCorpusModuleOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        OverwriteReadOnlyFiles="true" />
    <Message Importance="Normal"
             Text="OutWit.Controller.AI.Corpus: staged module to '$(_OutWitCorpusModuleOutputDir)'." />
  </Target>

  <Target Name="OutWitResolveCorpusAssets"
          AfterTargets="OutWitCopyCorpusModule"
          Condition="Exists('$(_OutWitCorpusModuleOutputDir)controller.json')">
    <ResolveControllerAssetsTask
        ManifestPath="$(_OutWitCorpusModuleOutputDir)controller.json"
        OutputPath="$(OutputPath)@Controllers\"
        ResolveForAllPlatforms="true" />
  </Target>

</Project>
