<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Scripts.props" />

  <PropertyGroup>
    <ControllerName>Verify</ControllerName>
    <Version>0.1.0</Version>
    <Description>Bundled .wit scripts for the OutWit Verify controller — VerifyRun (sandboxed code-vs-tests verification), VerifyPreflight, and VerifyRuntimeDiagnostics.</Description>
    <PackageTags>verify;sandbox;wasm;scripts;rlvr;witengine;witcloud;controller</PackageTags>
  </PropertyGroup>

  <!-- Compatibility marker (see docs/adr-001-script-controller-version-compatibility.md).
       ENABLE AT FIRST PUBLISH: the referenced controller package does not exist
       on any feed yet, so the marker would break restore until then.
  <ItemGroup>
    <PackageReference Include="OutWit.Controller.AI.Verify" Version="[0.1.0, 1.0.0)" />
  </ItemGroup>
  -->

  <ItemGroup>
    <None Include="..\OutWit.Controller.AI.Verify\Scripts\*.wit"
          Pack="true"
          PackagePath="content/scripts/" />

    <None Include="build\OutWit.Controller.AI.Verify.Scripts.targets"
          Pack="true"
          PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.Scripts.targets" />

</Project>
