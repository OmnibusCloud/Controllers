<Project>

  <!--
      Consumer-side targets for the OutWit.Controller.AI.Verify.Scripts NuGet
      package. Auto-imported into any csproj that PackageReferences this scripts
      pack. Copies content/scripts/*.wit into the consumer's $(OutputPath)@Scripts/
      flat layout.
  -->

  <PropertyGroup>
    <_OutWitVerifyScriptsContent>$(MSBuildThisFileDirectory)..\content\scripts\</_OutWitVerifyScriptsContent>
    <_OutWitVerifyScriptsOutputDir>$(OutputPath)@Scripts\</_OutWitVerifyScriptsOutputDir>
  </PropertyGroup>

  <Target Name="OutWitCopyVerifyScripts"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="Build"
          Condition="Exists('$(_OutWitVerifyScriptsContent)')">
    <ItemGroup>
      <_OutWitVerifyScriptFiles Include="$(_OutWitVerifyScriptsContent)*.wit" />
    </ItemGroup>
    <Copy
        SourceFiles="@(_OutWitVerifyScriptFiles)"
        DestinationFiles="@(_OutWitVerifyScriptFiles->'$(_OutWitVerifyScriptsOutputDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true"
        OverwriteReadOnlyFiles="true" />
    <Message Importance="Normal"
             Text="OutWit.Controller.AI.Verify.Scripts: staged @(_OutWitVerifyScriptFiles->Count()) script(s) to '$(_OutWitVerifyScriptsOutputDir)'." />
  </Target>

</Project>
