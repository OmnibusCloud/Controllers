<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Model.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <ControllerName>Smt</ControllerName>
    <Version>0.2.0</Version>
    <Description>The language layer and data types of the OutWit Smt controller: a strict SMT-LIB 2.6 reader with shape limits, shared by everything that reads a problem before a solver does, and the wire types of the packages a node solves and returns.</Description>
    <PackageTags>smt;smt-lib;z3;witengine;witcloud;controller;data-types</PackageTags>
  </PropertyGroup>

  <!-- The schema of a problem set's row, the contract a lab writes to: packed under docs/,
       beside the README that names it. -->
  <ItemGroup>
    <None Update="docs\smt-problems.schema.json" Pack="true" PackagePath="docs\smt-problems.schema.json" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.Model.targets" />

</Project>
