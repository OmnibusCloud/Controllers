LEAN__4.36.0-rc1__linux-x64=lean-4.36.0-rc1-linux.tar.zst 26b3cea1a006ad419215520b8668dcd3f6a9eeba1a123756563a739f9c6274b2
LEAN__4.36.0-rc1__linux-arm64=lean-4.36.0-rc1-linux_aarch64.tar.zst ed33fe9d78aca31e23b03159747b07b024c833c18e9d3fd1c01bd33f7aada731
LEAN__4.36.0-rc1__osx-arm64=lean-4.36.0-rc1-darwin_aarch64.tar.zst 9fbb1102490bfcb64ee8650b2c13f31c01985003028486cde818fffaaa45129e
LEAN__4.36.0-rc1__win-x64=lean-4.36.0-rc1-windows.tar.zst 2d8cd8cc897c8bf2681f7fc4c5118a71e8f91e40886b68f920efe2d385c5c51a
# Older toolchains: the Mathlib revisions probed for the cache's retention and the exporter's tags.
LEAN__4.15.0__linux-x64=lean-4.15.0-linux.tar.zst -
LEAN__4.25.0__linux-x64=lean-4.25.0-linux.tar.zst 97bee7bda676ca54f4b1cebe323242a08323d75134fecd1ba31cee4db66abb8a
LEAN__4.26.0-rc2__linux-x64=lean-4.26.0-rc2-linux.tar.zst 9d576f554d5134bb491d7c5acc3a024b447d2ac1b8123fcd899ef4462e162f4b

# Kit R1: PFR (Apache-2.0), Lean 4.36.0, Mathlib v4.36.0 (fc4f59e5) and add-combi.
R1_REPO=https://github.com/teorth/pfr
R1_COMMIT=54dc86a9c2eb28daf5b9f7593205cdc12345f27c
R1_LEAN=4.36.0
R1_MATHLIB=fc4f59e577feb1a4956671bc04ac18aaaf8cd842
R1_BUILD=PFRPalomar
R1_SOLUTION=PFRPalomar.Solution
R1_CHALLENGE=PFRPalomar.Challenge
R1_THEOREMS=Marton.pfr_conjecture,Marton.pfr_conjecture_nine,Marton.torsion_pfr_conjecture,Marton.weak_pfr_int,Marton.homomorphism_pfr,Marton.approx_hom_pfr
R1_MAIN=Marton.pfr_conjecture

# Kit R2: Carleson (Apache-2.0), Lean 4.36.0-rc1, a Mathlib master commit without a tag.
R2_REPO=https://github.com/fpvandoorn/carleson
R2_COMMIT=f7487cc9da4d1e73f009dc0280cd5b958f3e2c78
R2_LEAN=4.36.0-rc1
R2_MATHLIB=d88814353fcbcc0461c55b2a4585d3f44d903df1
R2_BUILD=Challenge Solution Carleson
R2_SOLUTION=Solution
R2_CHALLENGE=Challenge
R2_THEOREMS=classical_carleson_theorem,metric_space_carleson,linearized_metric_space_carleson
R2_MAIN=classical_carleson_theorem
# The project's `L^p` version, which its README says still rests on `sorry`.
R2_NEGATIVE_FILE=Carleson/Classical/CarlesonHunt.lean

# Mathlib revisions probed for the cache's retention (each with the toolchain its lean-toolchain names).
MATHLIB_REPO=https://github.com/leanprover-community/mathlib4
OLD_A_NAME=v4.15.0
OLD_A_COMMIT=9837ca9d65d9de6fad1ef4381750ca688774e608
OLD_A_LEAN=4.15.0
OLD_B_NAME=v4.25.0
OLD_B_COMMIT=1ccd71f89cbbd82ae7d097723ce1722ca7b01c33
OLD_B_LEAN=4.25.0
OLD_C_NAME=master-2025-11-26
OLD_C_COMMIT=6a9728ec6c59c1bc6e21b7e7228eafdcf3243890
OLD_C_LEAN=4.26.0-rc2
# The cache's public endpoint and the container of Mathlib's own builds (Cache/Infra.lean at R2's revision).
CACHE_FILES_URL=https://cache.mathlib.org/mathlib4-master/f

# The separate exporter at the tags matching the older toolchains (Apache-2.0).
LEAN4EXPORT_REPO=https://github.com/leanprover/lean4export
LEAN4EXPORT_A_TAG=v4.15.0
LEAN4EXPORT_A_COMMIT=20c4a64aa1b76f7c79a6db15d089084359f8c3dc
LEAN4EXPORT_B_TAG=v4.25.0
LEAN4EXPORT_B_COMMIT=cfefafacc917b2d14c5f9bb092ed337f71317a4a
