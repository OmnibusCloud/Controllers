<Project Sdk="Microsoft.NET.Sdk">

  <!-- PF-2 spike: the structural pre-check of an export (spec section 5.4) as the host and the node
       would run it, streaming, so that its time and memory are the controller's own cost. Not a
       product project: it is in no solution and is never packed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <IsPackable>false</IsPackable>
    <RootNamespace>OutWit.Controller.AI.Proof.Spike.Precheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

</Project>
