<Project Sdk="Microsoft.NET.Sdk">

  <!-- PF-2 spike: a `which` for the Windows sandbox. `lake comparator` runs `which git` and
       `which env` before it judges two exports; Git for Windows' MSYS `which.exe` cannot start in an
       AppContainer. This one searches PATH for NAME.exe and prints the first match. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>which</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
