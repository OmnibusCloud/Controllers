<Project Sdk="Microsoft.NET.Sdk">

  <!-- PF-2 spike, isolation option (b): a native kernel inside a Windows AppContainer (a low-box
       token with no capabilities: no network, file access only where granted) and a Job Object
       (memory and process caps, the tree killed on close). Not a product project: in no solution,
       never packed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>OutWit.Controller.AI.Proof.Spike.Sandbox</RootNamespace>
  </PropertyGroup>

</Project>
