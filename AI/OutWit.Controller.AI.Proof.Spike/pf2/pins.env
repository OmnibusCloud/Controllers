# PF-2 spike: everything the spike downloads beside PF-0's and PF-1's pins, each pinned. Nothing
# named here is committed to the repository: the exports are fetched from the MIT report's page by
# the workflows themselves and checked before use.

# The published verification of the shorter RH/GRH formalization (Andrew Sutherland, MIT).
GRH_PAGE=https://math.mit.edu/~drew/shortgrh
# The repository and commit the page checked; Lean and Mathlib it builds with.
GRH_REPO=https://github.com/lsernau/grh-lean
GRH_COMMIT=72fead102f663d5c7a407964a13dc0cf9d977207
GRH_LEAN=4.35.0
GRH_LEAN_GITHASH=eb6cafb7
GRH_MATHLIB=56a005855ea17e0b0958f73ec801ae140b0a1679
GRH_CHALLENGE_MODULE=Challenge
GRH_SOLUTION_MODULE=Main
GRH_THEOREMS=riemannHypothesis,riemannZeta_eq_zero_re,LFunction_ne_zero_of_half_lt_re,LFunction_eq_zero_re,LFunction_eq_zero_re_of_isPrimitive
GRH_AXIOMS=propext,Quot.sound,Classical.choice

# The exports: <file> <sha256 of the .zst (the page's SHA256SUMS)> <bytes> <sha256> (the page's exports.sha256).
EXPORT__compact=compact-solution.ndjson.zst d558294b0c2c659b76118cc8af8aa24c42464a22e1c0180440fa46997a4518c3 5172274528 ab7b4223b9bd748a1aa68bdb63afb6d6264121fc834aadba7ba3d3796c32115b
EXPORT__readable=readable-solution.ndjson.zst 7e99e474ecb7351f8ae2dbca76acab33eb5bfe5e626af34a4f298306762ac09d 4485867644 baf221c81749bf4bcbd6cd56238adfb4e8e780c38ef92d6a7ab458d57df36fc1
EXPORT__challenge=challenge.ndjson.zst ddc9f046c1f4f60954fad7e903075016488385fdccd3f571495a6250b7a15a05 354827875 20eb99a04b40f6afe1b44931e7ee82b15208542517dc588ace9634acffc41694

# The kernels bundled with Lean 4.36.0 (src/CMakeLists.txt at v4.36.0), built here from source for WASI.
NANODA_REPO=https://github.com/ammkrn/nanoda_lib
