<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Scripts.props" />

  <PropertyGroup>
    <ControllerName>Smt</ControllerName>
    <Version>1.0.0</Version>
    <Description>Bundled .wit scripts for the OutWit Smt controller: SmtRun (a problem set solved on anonymous nodes with sampled copies on different machines, a repair round on two machines that restores the copies, a dispute round, every sat model checked by the server's evaluator, and the results, report, provenance and integrity documents), SmtPreflight and SmtRuntimeDiagnostics.</Description>
    <PackageTags>smt;smt-lib;z3;solver;scripts;witengine;witcloud;controller</PackageTags>
  </PropertyGroup>

  <!-- Compatibility marker (see docs/adr-001-script-controller-version-compatibility.md).
       ENABLE WHEN THE CONTROLLER IS FIRST PUBLISHED TO NUGET.ORG. No version of the Smt
       controller is there: until one is, the feed these packages are restored from has no
       controller package, and a reference to a package a feed does not have breaks restore.
       The scripts need the activities the controller has since 0.4.0 (Smt.Split,
       Smt.SamplingRate, Smt.Repairs with the sampling rate, Smt.Disputes, Smt.Settle with the
       problem set and the sampling rate, Smt.Collect, Smt.CollectResults, Smt.Provenance,
       Smt.Integrity, Smt.Preflight), and Smt.Forget, which it has since 1.0.0. Its lower bound
       is the first controller version that feed will have (the decision record: a lower bound
       no feed has is noise at every restore), which is 1.0.0 at the earliest: a product release
       is never 0.x. Its upper bound is the next major, exclusive. When the first published
       version is a later one, the lower bound moves to it first, and the test's constant with
       it (SmtScriptsPackageTests holds the range to the release it waits for).
  <ItemGroup>
    <PackageReference Include="OutWit.Controller.AI.Smt" Version="[1.0.0, 2.0.0)" />
  </ItemGroup>
  -->

  <ItemGroup>
    <None Include="..\OutWit.Controller.AI.Smt\Scripts\*.wit"
          Pack="true"
          PackagePath="content/scripts/" />

    <None Include="build\OutWit.Controller.AI.Smt.Scripts.targets"
          Pack="true"
          PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.Scripts.targets" />

</Project>
