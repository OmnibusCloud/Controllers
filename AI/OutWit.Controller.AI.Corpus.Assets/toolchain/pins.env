# What the PDF extractor's build (build.sh) and its contract tests download, each pinned by
# SHA-256. An empty pin is reported as UNPINNED with the hash that was seen, and fails the
# build's last step.
#
# The module: pdftext/ (Cargo.toml pins pdf_oxide =0.3.78; Cargo.lock pins every crate by
# version and checksum, and the build runs with --locked), compiled for wasm32-wasip1 by the
# Rust below. No wasm-opt: the module is rustc's output as it is.

PDFTEXT_TARGET=wasm32-wasip1
PDF_OXIDE_VERSION=0.3.78

# Rust 1.99.1 of 2026-10-15 (pdf_oxide needs 1.88 or later; Verify's toolchain keeps 1.85.0
# for its own fixtures). The four packages a build for wasm32-wasip1 on Linux x64 needs,
# taken as they are from static.rust-lang.org instead of through rustup; the pins are the
# xz_hash values of the release's manifest, channel-rust-1.99.1.toml, whose own SHA-256 is
# fb152be80975c194aa5fc684b2aec3a6e14e2b855efe2faa4e5f8ae6e590f463.
RUST_VERSION=1.99.1
RUSTC_URL=https://static.rust-lang.org/dist/2026-10-15/rustc-1.99.1-x86_64-unknown-linux-gnu.tar.xz
RUSTC_SHA256=2ff05ff9c08a90861e7f6e4065b40a8b87463b4576186fd613871c3e37f2091f
CARGO_URL=https://static.rust-lang.org/dist/2026-10-15/cargo-1.99.1-x86_64-unknown-linux-gnu.tar.xz
CARGO_SHA256=53f3521949404d595efb06a55c12c5658d4ed1c75566f33d3d514eaebe70bd8a
RUST_STD_HOST_URL=https://static.rust-lang.org/dist/2026-10-15/rust-std-1.99.1-x86_64-unknown-linux-gnu.tar.xz
RUST_STD_HOST_SHA256=109b074225bf5b9ea3820890876bfdf4ed161adbfaf94b2b4b5984c85ee5d958
RUST_STD_TARGET_URL=https://static.rust-lang.org/dist/2026-10-15/rust-std-1.99.1-wasm32-wasip1.tar.xz
RUST_STD_TARGET_SHA256=d498fbff3fd032f2f5fabc299e5cbf7bc9d64abac6e389fc1a315b69821b48c4

# The engine the contract tests run the module on: the command line of the line the sandbox
# ships (Verify's pins.env pins the same file).
WASMTIME_VERSION=48.0.8
WASMTIME_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-linux.tar.xz
WASMTIME_SHA256=8716ce7bffa19d893b5b6dc01d8e298b1a81ab75a0455b5a2933156ea34a456e
