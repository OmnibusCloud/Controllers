<Project Sdk="Microsoft.NET.Sdk">

  <!-- The live client of the Smt controller: drives SmtRuntimeDiagnostics, SmtPreflight and
       SmtRun on a real server through the public SDK, the way a lab's application does, checks
       the documents a run gives against their schemas, compares two runs of one problem set,
       packs a folder of SMT-LIB files into a problem set, runs a set on this machine alone with
       the controller's own code, and compares such a run with a fleet's. A developer tool, not a
       package: never packed or published. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>smt-live</AssemblyName>
    <RootNamespace>OutWit.Controller.AI.Smt.Live</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The tool's unit tests and the demo kits live in this folder; they are not its sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**;demo/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OutWit.Cloud.SDK" Version="2.2.0" />
  </ItemGroup>

  <!-- The model package: the options, the preflight and the diagnostics travel as its types, and
       the problem set is read and sanitized here by the code the server reads it with. -->
  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.AI.Smt.Model\OutWit.Controller.AI.Smt.Model.csproj" />
  </ItemGroup>

  <!-- The controller itself, for `local`: the set is read and cut into packages by the host's
       code, every problem is solved by the node's session code in the controller's own sandbox
       (the module and the native engine library held to their pins by the controller), and the
       run is settled and its documents written by the host's code. That code is internal to the
       controller, which names the tool as a friend (InternalsVisibleTo("smt-live")): at run time
       the tool calls the very assembly a node loads. -->
  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.AI.Smt\OutWit.Controller.AI.Smt.csproj" />
  </ItemGroup>

  <!-- The wasmtime binding without its package's native library (48.0.2): the controller's
       sandbox loads only the pinned library (wasmtime 48.0.8), from runtimes/<rid>/native/ beside
       the controller's assembly, where a publish (build/SmtLiveAssets.targets) or the tests' build
       puts it. -->
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="48.0.2" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.Controller.AI.Smt.Live.Tests" />
  </ItemGroup>

  <!-- The schemas of the controller's documents, beside the tool under docs/: every document a
       run or a diagnostics job gives is held to its schema as the controller publishes it. -->
  <ItemGroup>
    <None Include="..\OutWit.Controller.AI.Smt\docs\smt-*.schema.json" Link="docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The solver's data assets beside the tool: on a publish for one platform, and on a build
       with -p:SmtLiveAssets=true. -->
  <Import Project="build\SmtLiveAssets.targets" />

</Project>
