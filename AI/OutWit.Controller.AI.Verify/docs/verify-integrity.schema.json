{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmnibusCloud/Controllers/AI/OutWit.Controller.AI.Verify/docs/verify-integrity.schema.json",
  "title": "Verify integrity",
  "description": "The integrity blob of every Verify script: the share of batches (VerifyOptions.SamplingRate) that ran twice in one Grid.ForEach call, the two executions of each task compared on everything an honest node cannot vary (verdict, exit code, outputs, per-case outcomes). The platform keeps the two on different machines and the document does not say which. Empty pairs at rate 0.",
  "type": "object",
  "required": ["summary", "pairs"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "object",
      "required": ["sampled", "compared", "mismatches", "mismatch_rate"],
      "additionalProperties": false,
      "properties": {
        "sampled": { "type": "integer", "description": "Pairs of executions of one task." },
        "compared": { "type": "integer", "description": "Pairs compared; every pair is." },
        "mismatches": { "type": "integer", "description": "Compared pairs that disagree." },
        "mismatch_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "mismatches / compared; 0 when nothing was compared." }
      }
    },
    "pairs": {
      "type": "array",
      "description": "One record per sampled task, ordered by index.",
      "items": {
        "type": "object",
        "required": ["index", "primary", "replica", "compared"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer" },
          "primary": { "$ref": "#/$defs/side" },
          "replica": { "$ref": "#/$defs/side" },
          "compared": { "type": "boolean" },
          "match": { "type": "boolean", "description": "Present when compared." },
          "differs": { "type": "array", "items": { "type": "string", "enum": ["verdict", "exit", "stdout", "stderr", "cases"] }, "description": "Present on a mismatch: the fields that differ." }
        }
      }
    }
  },
  "$defs": {
    "side": {
      "type": ["object", "null"],
      "required": ["verdict", "exit"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "type": "string" },
        "exit": { "type": "integer" }
      }
    }
  }
}
