<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.props" />

  <PropertyGroup>
    <ControllerName>Verify</ControllerName>
    <Version>0.11.3</Version>
    <Description>Sandboxed, deterministic, resource-metered execution of untrusted programs against specifications (WASM/wasmtime): code-vs-tests verification, code and math corpus generation, formal proof checking — verification by construction on anonymous nodes.</Description>
    <PackageTags>verify;sandbox;wasm;wasmtime;rlvr;code-execution;witengine;witcloud;controller</PackageTags>
    <ControllerFeatures>verify-execute</ControllerFeatures>
    <ControllerUseCases>RLVR code verification and generated-corpus checking on volunteer pools</ControllerUseCases>
  </PropertyGroup>

  <ItemGroup>
    <ControllerDependency Include="Variables" MinimumVersion="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.AI.Verify.Model\OutWit.Controller.AI.Verify.Model.csproj" />
  </ItemGroup>

  <!-- WASM sandbox host: the Wasmtime.Dotnet managed binding over the native wasmtime
       library. A package stages nothing into the module by itself (the Simulation
       precedent), so the binding is declared below and copied next to the controller.
       The natives (one per RID, under runtimes/<rid>/native/) and the language runtime
       modules (under wasm/) are Tier-2 data assets fetched by consumers at build time;
       the module's deps.json names the natives, and the engine's plugin load context
       (AssemblyDependencyResolver + LoadUnmanagedDll) resolves them from the module
       folder. In-solution tests resolve wasmtime from the test bin; the module-load test
       proves the deployed layout through the real isolated loader. -->
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>

  <!-- The wasm sandbox host, shared with the other AI controllers as source, not as an assembly:
       the cloud client loads every controller into one shared load context, where an assembly
       name loads once and the first controller to load it wins. Compiled in here, the host's
       types (internal, namespace OutWit.Controller.AI.Wasm) are this controller's own copy, and
       the controller works with or without any other. The one assembly the controllers share is
       the binding above, pinned to the same version in each (WasmHostBinding.BUILT_AGAINST). -->
  <ItemGroup>
    <Compile Include="..\Shared\Wasm\**\*.cs" Link="Wasm\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ControllerModuleAssembly Include="Wasmtime.Dotnet" />
  </ItemGroup>

  <!-- Tier-2 data assets, fetched by consumers at build time from GitHub releases of this
       repository. Three native wasmtime libraries, one per RID, from the neutral asset release
       wasmtime-v48.0.8 (the bytes verify-v0.6.0 carried; Corpus references the same asset),
       extracted to the folder the module's deps.json names; the wasm host's natives guard
       (WasmHostNatives.PINNED) holds the library inside each to its SHA-256. One
       platform-independent set of language runtime modules (tag verify-v<version>; the URI stays
       on an older tag while the bytes do not change) extracted to wasm/. Sha256/Size are filled by outwit-assets-pack from
       @Prerequisites/ (PackSource/PackKind are author-only and never reach the manifest).
       RuntimeIdentifier uses RIDs; the node-side layout uses the same names here because
       the .NET resolver, not our own probe, reads them. -->
  <ItemGroup>
    <ControllerDataAsset Include="wasmtime-win-x64">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/wasmtime-v48.0.8/wasmtime-win-x64.zip</Uri>
      <Sha256>c4e799ba8b7f625a8e5aee1f6c43d0a57b2ce6ce0824e7a13ca62144c94bfdc5</Sha256>
      <Size>8284072</Size>
      <ExtractTo>runtimes/win-x64/native/</ExtractTo>
      <PackSource>wasmtime/win-x64</PackSource>
      <PackKind>zip-folder</PackKind>
    </ControllerDataAsset>
    <ControllerDataAsset Include="wasmtime-linux-x64">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/wasmtime-v48.0.8/wasmtime-linux-x64.zip</Uri>
      <Sha256>9ea38410c9e9ac0e6a2983dbcca5b324cf0c8a12159ed9ec186cd195f987c4a8</Sha256>
      <Size>9963229</Size>
      <ExtractTo>runtimes/linux-x64/native/</ExtractTo>
      <PackSource>wasmtime/linux-x64</PackSource>
      <PackKind>zip-folder</PackKind>
    </ControllerDataAsset>
    <ControllerDataAsset Include="wasmtime-osx-arm64">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/wasmtime-v48.0.8/wasmtime-osx-arm64.zip</Uri>
      <Sha256>252af1df65b0fa10fa67d0dece7713d6e5e61bde438ae9083993a75c5ef5a3d9</Sha256>
      <Size>8563340</Size>
      <ExtractTo>runtimes/osx-arm64/native/</ExtractTo>
      <PackSource>wasmtime/osx-arm64</PackSource>
      <PackKind>zip-folder</PackKind>
    </ControllerDataAsset>
    <ControllerDataAsset Include="verify-wasm">
      <Uri>gh-release://OmnibusCloud/Controllers/verify-v0.10.0/verify-wasm.zip</Uri>
      <Sha256>d6c7340436bf4bea2593c6cc6dff78531914ff599738407b98cb730625b61fd3</Sha256>
      <Size>68723812</Size>
      <ExtractTo>wasm/</ExtractTo>
      <PackSource>wasm</PackSource>
      <PackKind>zip-folder</PackKind>
    </ControllerDataAsset>
    <!-- The numpy runtime's folder (python-3.14.6-numpy-2.5.4): its start-up snapshot is bound to
         the bytes of the two layers it was made with, so the folder travels as one asset of its
         own. Built from pinned sources by the AI Verify python-numpy workflow (two builds
         compared byte for byte), not packed from @Prerequisites/; the bytes are the same on
         every platform. -->
    <ControllerDataAsset Include="verify-python-numpy">
      <RuntimeIdentifier>any</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/verify-v0.11.0/verify-python-numpy.zip</Uri>
      <Sha256>6b70674b209288f3fad36d7448e84ab9ff1903b61352c9903ea7e82504f15b0e</Sha256>
      <Size>17216715</Size>
      <ExtractTo>wasm/python-3.14.6-numpy-2.5.4/</ExtractTo>
    </ControllerDataAsset>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\OutWit.Controller.AI.Verify.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.targets" />

</Project>
