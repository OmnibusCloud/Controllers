Job:VerifyRun(Blob:taskset, VerifyOptions:opts)
{
    VerifyTaskBatchCollection:batches = Verify.Split(taskset, opts);

    VerifyResultBatchCollection:results = Grid.ForEach(batch in batches)
        => Verify.ExecuteBatch(batch);

    VerifyTaskBatchCollection:replicaBatches = Verify.Sample(batches, opts);

    VerifyResultBatchCollection:replicas = Grid.ForEach(batch in replicaBatches)
        => Verify.ExecuteBatch(batch);

    Blob:report = Verify.Collect(results, opts);
    Blob:provenance = Verify.Provenance(results);
    Blob:integrity = Verify.Integrity(results, replicas);
}
