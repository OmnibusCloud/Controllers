Job:VerifyGenerate(Blob:taskset, VerifyOptions:opts)
{
    VerifyTaskBatchCollection:batches = Verify.Split(taskset, opts);

    Double:rate = Verify.SamplingRate(opts);
    ProcessingOptions:checked = Grid.Replicas(2, rate);

    VerifyResultBatchCollection:results = Grid.ForEach(batch in batches, checked)
        => Verify.ExecuteBatch(batch);

    Blob:corpus = Verify.CollectOutputs(results, opts);
    Blob:report = Verify.Collect(results, opts);
    Blob:provenance = Verify.Provenance(results);
    Blob:integrity = Verify.Integrity(results);
}
