Job:VerifyGenerateAndCheck(Blob:generators, Blob:checker, VerifyOptions:opts)
{
    VerifyTaskBatchCollection:generatorBatches = Verify.Split(generators, opts);

    VerifyResultBatchCollection:candidates = Grid.ForEach(batch in generatorBatches)
        => Verify.ExecuteBatch(batch);

    VerifyTaskBatchCollection:checkBatches = Verify.MakeCheckTasks(candidates, checker, opts);

    Double:rate = Verify.SamplingRate(opts);
    ProcessingOptions:checked = Grid.Replicas(2, rate);

    VerifyResultBatchCollection:verdicts = Grid.ForEach(batch in checkBatches, checked)
        => Verify.ExecuteBatch(batch);

    Blob:report = Verify.Collect(verdicts, opts);
    Blob:corpus = Verify.CollectOutputs(candidates, opts);
    Blob:provenance = Verify.Provenance(verdicts);
    Blob:integrity = Verify.Integrity(verdicts);
}
