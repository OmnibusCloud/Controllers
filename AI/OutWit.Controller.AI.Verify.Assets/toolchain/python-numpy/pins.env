# What the numpy runtime's build (python-numpy/build.sh) downloads, each pinned by SHA-256. An empty
# pin is reported as UNPINNED with the hash that was seen, and fails the build's last step.
#
# CPython is the catalog's version (3.14.6) built by its own WASI driver with the WASI SDK that
# release supports (24), the same pairing as the brettcannon build the runtime set takes; numpy is
# built against it as static archives and linked in as builtin modules.

CPYTHON_VERSION=3.14.6
CPYTHON_URL=https://www.python.org/ftp/python/3.14.6/Python-3.14.6.tar.xz
CPYTHON_SHA256=143b1dddefaec3bd2e21e3b839b34a2b7fb9842272883c576420d605e9f30c63
# The newest file in that tarball (2026-06-10 10:03:53 UTC): the build's SOURCE_DATE_EPOCH, the
# date sys.version shows.
CPYTHON_SOURCE_DATE_EPOCH=1781085833

# GitHub shows no digest for this release's files; the pin is the hash of the 118,879,731 bytes.
WASI_SDK24_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-24/wasi-sdk-24.0-x86_64-linux.tar.gz
WASI_SDK24_SHA256=c6c38aab56e5de88adf6c1ebc9c3ae8da72f88ec2b656fb024eda8d4167a0bc5

NUMPY_VERSION=2.5.4
NUMPY_URL=https://files.pythonhosted.org/packages/95/b0/c7453d0b6e2073c3264468b106ee1563750cecc910965e67357e3698c83e/numpy-2.5.4.tar.gz
NUMPY_SHA256=9a94cf751c9ad8ebaa835bcd3d40dacf8534ad086b88c38029b65123c7999d2a

# Build tools, run on the build host only: Cython (numpy's random module) and ninja (meson's backend).
# numpy configures with its own vendored meson.
CYTHON_URL=https://files.pythonhosted.org/packages/bf/77/67b0b24e45073a699610e50f00c18474ff9b09ea29ecc95083bdf5e60acd/cython-3.3.0-py3-none-any.whl
CYTHON_SHA256=9b24b5c8cd536946b62086fcafee6d5509d3f549f72d553d2336af87ffbe0da1
NINJA_URL=https://files.pythonhosted.org/packages/6e/53/ebfed7b689c338dd8ebeec9c0730c8d56821292f14e2536e5f3ef1a05744/ninja-1.13.2-py3-none-manylinux2014_x86_64.manylinux_2_17_x86_64.whl
NINJA_SHA256=65a24341b5ac09fcadcc37082660be40a94174e51a937fabf6e2cae26225fa2c
