# What the toolchain build downloads, each pinned by SHA-256. An empty pin is reported as
# UNPINNED with the hash that was seen, and fails the build's last step.
#
# The pins are the values the publishers state: the digests GitHub shows for the wasi-sdk
# and wasmtime release files, and the checksum on https://www.lua.org/ftp/ for Lua. lua.org
# does not always answer a build server, so the same archive is also taken from a mirror;
# the pin is what makes the two the same file.

WASI_SDK_VERSION=34.0
WASI_SDK_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-34.0-x86_64-linux.tar.gz
WASI_SDK_SHA256=b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4

LUA_VERSION=5.4.8
LUA_URL=https://www.lua.org/ftp/lua-5.4.8.tar.gz
LUA_MIRROR_URL=https://ftp.osuosl.org/pub/blfs/conglomeration/lua/lua-5.4.8.tar.gz
LUA_SHA256=4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae

RUST_VERSION=1.85.0

# The engine the sandbox runs on: the long-term line 48, its newest patch. The command line
# runs the toolchain job's modules; the C API archives are the native libraries the controller
# ships (natives.sh), under the .NET binding 48.0.2.
WASMTIME_VERSION=48.0.8
WASMTIME_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-linux.tar.xz
WASMTIME_SHA256=8716ce7bffa19d893b5b6dc01d8e298b1a81ab75a0455b5a2933156ea34a456e

WASMTIME_NATIVE_VERSION=48.0.8
WASMTIME_NATIVE_WIN_X64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-windows-c-api.zip
WASMTIME_NATIVE_WIN_X64_SHA256=31c2d97399b2555c06233a5fe0d2ba7373d020dae584107b1e3f459dd1756c42
WASMTIME_NATIVE_LINUX_X64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-linux-c-api.tar.xz
WASMTIME_NATIVE_LINUX_X64_SHA256=6cd2e5a976d68932afb546c2d14d89ba9e5578127a9716a13500dde40fc1e0e6
WASMTIME_NATIVE_OSX_ARM64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-aarch64-macos-c-api.tar.xz
WASMTIME_NATIVE_OSX_ARM64_SHA256=2c7c4e75ca41f505867ef7c836c942c6b1190f708939753d10d1927585eaed59

# Binaryen's wasm-opt turns Lua's error jump into an asyncify unwind (lua-asyncify.h), so the
# interpreter needs no exception-handling feature. Build time only.
BINARYEN_VERSION=133
BINARYEN_URL=https://github.com/WebAssembly/binaryen/releases/download/version_133/binaryen-version_133-x86_64-linux.tar.gz
BINARYEN_SHA256=2dc9c7813f5375db93d96ead4b78222fcc3e2677bbb832297af4797782a37489

# Lua's own test suite, the toolchain job's gate for the WASI build, kept in gates/ (lua.org publishes no
# digest for it; the pin is the hash of the file of 137,066 bytes on https://www.lua.org/tests/).
LUA_TESTS_URL=https://www.lua.org/tests/lua-5.4.8-tests.tar.gz
LUA_TESTS_SHA256=9581d5a7c39ffbf29b8ccde2709083c380f7bbddbd968dcb15712d2f2e33f4e5

# QuickJS-NG, built here instead of taken from its release: the release's WASI build places a
# 64 KiB C stack after its data with the stack limit off (a deep recursion overwrote the
# interpreter's data). The release publishes no source archive with a digest; the pin is the
# hash of the tag's archive, which GitHub keeps stable.
QUICKJS_VERSION=0.15.1
QUICKJS_URL=https://github.com/quickjs-ng/quickjs/archive/refs/tags/v0.15.1.tar.gz
QUICKJS_SHA256=c4e813951b7c46845096a948e978c620b11ab4cf5fd622ca09c727ec31f42623
