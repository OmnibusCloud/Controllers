# What the toolchain build downloads, each pinned by SHA-256. An empty pin is reported as
# UNPINNED with the hash that was seen, and fails the build's last step.

WASI_SDK_VERSION=34.0
WASI_SDK_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-34.0-x86_64-linux.tar.gz
WASI_SDK_SHA256=

LUA_VERSION=5.4.8
LUA_URL=https://www.lua.org/ftp/lua-5.4.8.tar.gz
LUA_SHA256=

RUST_VERSION=1.85.0

WASMTIME_VERSION=44.0.0
WASMTIME_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v44.0.0/wasmtime-v44.0.0-x86_64-linux.tar.xz
WASMTIME_SHA256=
