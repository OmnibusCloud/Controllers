<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain .NET 10 executable, as a host application is built: on Windows its apphost is
       CET-compatible by default, so the process runs with hardware-enforced stack protection.
       VerifyHostProtectionTests runs it to prove a guest's trap does not take such a host down. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.AI.Verify\OutWit.Controller.AI.Verify.csproj" />
  </ItemGroup>

</Project>
