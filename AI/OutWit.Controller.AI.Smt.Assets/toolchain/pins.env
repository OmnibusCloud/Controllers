# What the build of the Smt controller's solver module (build.sh, pack.sh) and its tests
# download, each pinned by SHA-256, and what they build to. An empty pin of a download is
# reported as UNPINNED with the hash that was seen, and stops the build before anything is
# unpacked or run. The pins of the three archives are the digests GitHub states for the
# release files.

# Z3, the solver (MIT): release 5.4.1 of 2026-11-11, tag z3-5.4.1. The archive is the
# release's own source file (13,128,310 bytes).
Z3_VERSION=5.4.1
Z3_COMMIT=145c0c51570a357cc558ce898ce77573ba9d4fbf
Z3_SOURCE_URL=https://github.com/Z3Prover/z3/releases/download/z3-5.4.1/z3-5.4.1-source.tar.gz
Z3_SOURCE_SHA256=59002cc86aeb845798a6cb200f8f09e5205b20cd7fab0316befb2e355e396c83
# Three files of that archive, each by the hash it has there: LICENSE.txt, which travels with
# the module, and the two the build does not take as they are: src/util/scoped_timer.cpp
# (replaced by wasi/scoped_timer.cpp) and src/util/hwf.cpp (edited by patch.py). A Z3 release
# that changes one of them stops the build until the change is read and the pin moved.
Z3_LICENSE_SHA256=e617cad2ab9347e3129c2b171e87909332174e17961c5c3412d0799469111337
Z3_SCOPED_TIMER_SHA256=468bf0dc0f0820d87b08507c5620bcd246d03af41cdf4370cd7743c505ae7b2f
Z3_HWF_SHA256=fdc266dee8190fffbe0f30c77960405aa5ef8e2e3f9acd3452cd8ff5d61cf6de

# The compiler: wasi-sdk 34.0 of 2026-08-25 for Linux x64 (clang 23.1.0), the file the Verify
# toolchain's pins.env pins too. Its sysroot has libc++ and libc++abi twice, built without and
# with WebAssembly exceptions (lib/wasm32-wasip1/noeh and eh), and libunwind beside the second;
# -fwasm-exceptions selects the second.
WASI_SDK_VERSION=34.0
WASI_SDK_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-34.0-x86_64-linux.tar.gz
WASI_SDK_SHA256=b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4
# The commits of wasi-libc and of LLVM that SDK was built from. Its VERSION file names each by
# its first twelve digits, and the build holds the SDK to these two lines.
WASI_LIBC_COMMIT=2e6fb9d8ee0cdf9e431fbcabe8af3115de000a13
LLVM_COMMIT=895aa2c896ada719451be2e3673c83da8ddf1141

# The licence texts of what the SDK links into the module, for the notices that travel with it
# (notices.py, which names each file's path): files of the two projects' repositories at the
# commits above, https://raw.githubusercontent.com/WebAssembly/wasi-libc/<commit>/<path> and
# https://raw.githubusercontent.com/llvm/llvm-project/<commit>/<path>. The wasi-libc files and
# compiler-rt's are the files the Verify toolchain's notices table pins too.
WASI_LIBC_LICENSE_SHA256=2711a8b5a5cdfef0e639f96c1aca12ae23d7d64a02d0507f1bdf14d2b27bbc3a
WASI_LIBC_LICENSE_APACHE_LLVM_SHA256=268872b9816f90fd8e85db5a28d33f8150ebb8dd016653fb39ef1f94f2686bc5
WASI_LIBC_LICENSE_APACHE_SHA256=a60eea817514531668d7e00765731449fe14d059d3249e0bc93b36de45f759f2
WASI_LIBC_LICENSE_MIT_SHA256=23f18e03dc49df91622fe2a76176497404e46ced8a715d9d2b67a7446571cca3
WASI_LIBC_MUSL_COPYRIGHT_SHA256=b870108ec5e7790e9f9919064f1b9421d62d5f9b0e6c230c6adf7ea2da62e97b
WASI_LIBC_CLOUDLIBC_LICENSE_SHA256=c8b789cf5a746611e6300a0cc7750dbf92b61912a709d04e639245f7290656d0
WASI_LIBC_MUSL_FTS_COPYING_SHA256=55af87e4017668f54467a3380e7ebbac5e672d8c763bfe95e6fc882a6fdc4046
LLVM_LIBCXX_LICENSE_SHA256=539dd7aed86e8a4f12cbdd0e6c50c189c7d74847e4fecc64ce2c6ee3a01da38b
LLVM_LIBCXXABI_LICENSE_SHA256=e2b35be49f7284a45b7baca8fc7b3ab7440e7902392b2528a457816b5bb2a15c
LLVM_LIBUNWIND_LICENSE_SHA256=b5efebcaca80879234098e52d1725e6d9eb8fb96a19fce625d39184b705f7b6d
LLVM_COMPILER_RT_LICENSE_SHA256=1a8f1058753f1ba890de984e48f0242a3a5c29a6a8f2ed9fd813f36985387e8d

# The engine the tests run the module on: the command line of wasmtime 48.0.8 of 2026-10-29
# for Linux x64, of the line the sandbox ships (the pins.env files of the Verify and Corpus
# toolchains pin the same file).
WASMTIME_VERSION=48.0.8
WASMTIME_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-linux.tar.xz
WASMTIME_SHA256=8716ce7bffa19d893b5b6dc01d8e298b1a81ab75a0455b5a2933156ea34a456e

# What the pins above build to: the module (z3-5.4.1.wasm) and the data asset that carries it
# to a node (smt-z3-wasm.zip), each by SHA-256 and size in bytes. The workflow's compare job
# fails when a build gives another module or another archive. After a change that is meant to
# move one of them, the values that job prints are the new pins. The build itself does not
# depend on these four lines.
Z3_MODULE_SHA256=9b8a67e85542b5d62d30b40060dd237fcef07f794ea235483afc83eef47a1364
Z3_MODULE_SIZE=30204160
SMT_Z3_WASM_SHA256=3c3f67877e4e193dc64070023fbf64addb4b01520de4b9fa79b673b77d48cc02
SMT_Z3_WASM_SIZE=30314801
