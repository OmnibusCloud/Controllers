<Project Sdk="Microsoft.NET.Sdk">

  <!-- The PDF-to-text spike of the Corpus controller: two managed extractors side by side
       (PdfPig and PdfLibrary) on real Common Crawl PDFs and on a generated hostile set, each
       document in a child process with a time and memory ceiling, the text hashed so that three
       operating systems can be compared. A measuring tool, not a package and not a stage. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>pdf-spike</AssemblyName>
    <RootNamespace>OutWit.Controller.AI.Corpus.PdfSpike</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- The stable release by default; a nightly can be measured with -p:PdfPigVersion=... -->
    <PdfPigVersion Condition="'$(PdfPigVersion)' == ''">0.1.16</PdfPigVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="$(PdfPigVersion)" />
    <PackageReference Include="Lxman.PdfLibrary" Version="2.6.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="cc-pdfs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
