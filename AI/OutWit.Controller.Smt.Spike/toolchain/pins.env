# The benchmark slice: SMT-LIB release 2025, non-incremental (Zenodo record 16740866, DOI
# 10.5281/zenodo.16740866; the collection under CC BY 4.0, each benchmark's own licence in its
# :license field). Zenodo states MD5 digests; the SHA-256 of every extracted file is pinned in
# bench/fetch-list.tsv instead, so no archive is ever kept or committed.
SMTLIB_RECORD=16740866
SMTLIB_URL_PREFIX=https://zenodo.org/records/16740866/files
