# SM-0 spike: what the Z3 wasm build, the native baseline and the benchmark slice download,
# each pinned by SHA-256 (the digests GitHub states for the release files; the source archive
# is Z3's own release asset). An empty pin is reported as UNPINNED and fails the build.

# Z3, the solver (MIT). The newest release on 2026-11-14.
Z3_VERSION=5.4.1
Z3_COMMIT=145c0c51570a357cc558ce898ce77573ba9d4fbf
Z3_SOURCE_URL=https://github.com/Z3Prover/z3/releases/download/z3-5.4.1/z3-5.4.1-source.tar.gz
Z3_SOURCE_SHA256=59002cc86aeb845798a6cb200f8f09e5205b20cd7fab0316befb2e355e396c83
# The one source file the wasm build replaces (toolchain/wasi/scoped_timer.cpp): the hash of
# the original, so a new Z3 release cannot slip a changed timer past the shim.
Z3_SCOPED_TIMER_SHA256=468bf0dc0f0820d87b08507c5620bcd246d03af41cdf4370cd7743c505ae7b2f

# The compiler: the same wasi-sdk as Verify's toolchain (clang 22). From wasi-sdk 33 on its
# sysroot carries a second libc++/libc++abi/libunwind built with wasm exceptions (the standard
# exnref proposal), chosen by -fwasm-exceptions.
WASI_SDK_VERSION=34.0
WASI_SDK_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-34.0-x86_64-linux.tar.gz
WASI_SDK_SHA256=b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4

# The engine's command line, for the build job's smoke test (the harness uses the .NET binding).
WASMTIME_VERSION=48.0.8
WASMTIME_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-linux.tar.xz
WASMTIME_SHA256=8716ce7bffa19d893b5b6dc01d8e298b1a81ab75a0455b5a2933156ea34a456e

# The native libraries under the .NET binding 48.0.2, per runtime identifier (C API archives).
WASMTIME_NATIVE_WIN_X64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-windows-c-api.zip
WASMTIME_NATIVE_WIN_X64_SHA256=31c2d97399b2555c06233a5fe0d2ba7373d020dae584107b1e3f459dd1756c42
WASMTIME_NATIVE_WIN_ARM64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-aarch64-windows-c-api.zip
WASMTIME_NATIVE_WIN_ARM64_SHA256=2dd5ec2f86b9d50da93e4f29985472c0520ee3545e5ab9e8771430f39011c269
WASMTIME_NATIVE_LINUX_X64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-linux-c-api.tar.xz
WASMTIME_NATIVE_LINUX_X64_SHA256=6cd2e5a976d68932afb546c2d14d89ba9e5578127a9716a13500dde40fc1e0e6
WASMTIME_NATIVE_LINUX_ARM64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-aarch64-linux-c-api.tar.xz
WASMTIME_NATIVE_LINUX_ARM64_SHA256=3bb7d77fcbf0da214b7d56fc1f244e77b6dbb51b740c63ff7cbd8ece398308dc
WASMTIME_NATIVE_OSX_ARM64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-aarch64-macos-c-api.tar.xz
WASMTIME_NATIVE_OSX_ARM64_SHA256=2c7c4e75ca41f505867ef7c836c942c6b1190f708939753d10d1927585eaed59
WASMTIME_NATIVE_OSX_X64_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.8/wasmtime-v48.0.8-x86_64-macos-c-api.tar.xz
WASMTIME_NATIVE_OSX_X64_SHA256=07dc84f84debc1cca9f79c5b75200799296bb53d83f2e9d0e8dc83fe05245a63

