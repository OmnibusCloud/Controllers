<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Tests.props" />

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.AI.Verify\OutWit.Controller.AI.Verify.csproj" />
  </ItemGroup>

  <!-- Build-only references: these projects must be built (so their PostBuild
       populates @Controllers/<Cfg>/<name>.module/) but their DLLs are not pulled
       into the test compile output. Variables is the Verify module dependency;
       Grid/Special are the script-level dependencies of VerifyRun.wit
       (Grid.ForEach and the typed-variable/flow constructs the engine resolves). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Variables\OutWit.Controller.Variables\OutWit.Controller.Variables.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\Grid\OutWit.Controller.Grid\OutWit.Controller.Grid.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\Special\OutWit.Controller.Special\OutWit.Controller.Special.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ExcludedControllerModule Include="render.module" />
    <ExcludedControllerModule Include="renderdcc.module" />
  </ItemGroup>

  <!-- Wasmtime sandbox spike. The sandbox tests are opt-in: they Assert.Ignore
       unless @Data/runtimes/ holds the pinned CPython-WASI + QuickJS modules
       (fetch via download-spike-runtimes.ps1; @Data/ is gitignored). -->
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="44.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Sandbox\Golden\*.golden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
