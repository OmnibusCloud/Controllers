<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.props" />

  <PropertyGroup>
    <ControllerName>Smt</ControllerName>
    <Version>0.5.0</Version>
    <Description>SMT problems solved on anonymous nodes by a pinned Z3 that runs as a WebAssembly module in a wasm sandbox: check, enumerate and prove under a deterministic budget, so the same problem gives the same answer, the same model and the same cost on every machine.</Description>
    <PackageTags>smt;smt-lib;z3;solver;wasm;wasmtime;witengine;witcloud;controller</PackageTags>
    <ControllerFeatures>smt-solve</ControllerFeatures>
    <ControllerUseCases>Checking, enumerating and proving SMT problems at CPU scale with every answer reproducible</ControllerUseCases>
  </PropertyGroup>

  <!-- The scripts that run the controller's activities take blobs and collections of the
       Variables controller. -->
  <ItemGroup>
    <ControllerDependency Include="Variables" MinimumVersion="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OutWit.Controller.AI.Smt.Model\OutWit.Controller.AI.Smt.Model.csproj" />
  </ItemGroup>

  <!-- The schemas of the documents a lab reads (the capabilities, and the results, the report,
       the provenance and the integrity of a run) and what a lab can rely on: the contract,
       packed under docs/, beside the README that names them. -->
  <ItemGroup>
    <None Update="docs\smt-capabilities.schema.json" Pack="true" PackagePath="docs\smt-capabilities.schema.json" />
    <None Update="docs\smt-results.schema.json" Pack="true" PackagePath="docs\smt-results.schema.json" />
    <None Update="docs\smt-report.schema.json" Pack="true" PackagePath="docs\smt-report.schema.json" />
    <None Update="docs\smt-provenance.schema.json" Pack="true" PackagePath="docs\smt-provenance.schema.json" />
    <None Update="docs\smt-integrity.schema.json" Pack="true" PackagePath="docs\smt-integrity.schema.json" />
    <None Update="docs\capabilities.md" Pack="true" PackagePath="docs\capabilities.md" />
  </ItemGroup>

  <!-- The solver's sandbox: the Wasmtime.Dotnet managed binding over the native wasmtime
       library, the same version Verify and Corpus reference (one binding per process in the
       client's shared load context; WasmHostBinding.BUILT_AGAINST and the repository pins test
       hold them together). A package stages nothing into the module by itself, so the binding
       is declared below and copied next to the controller; the natives are data assets. -->
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>

  <!-- The wasm sandbox host, shared with the other AI controllers as source, not as an assembly:
       compiled in here, its types (internal, namespace OutWit.Controller.AI.Wasm) are this
       controller's own copy, and Smt works with or without any other controller. -->
  <ItemGroup>
    <Compile Include="..\Shared\Wasm\**\*.cs" Link="Wasm\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ControllerModuleAssembly Include="Wasmtime.Dotnet" />
  </ItemGroup>

  <!-- What the module carries of others, and its terms: beside Wasmtime.Dotnet.dll, the one
       assembly in the module that is not the controller's own. A committed file, kept byte for
       byte on every checkout (.gitattributes), since the module's content digest covers it; a
       test holds it to the binding the build restored and to the licence text it gives. -->
  <ItemGroup>
    <ControllerModuleFile Include="$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- Tier-2 data assets, fetched by consumers at build time from the neutral asset release of
       this repository, each pinned here by its SHA-256 and its size. The three native wasmtime
       libraries (wasmtime-v48.0.8-2: the libraries of wasmtime 48.0.8, packed with the engine's
       third-party notices) are the very bytes Verify and Corpus ship, extracted to the folder
       the module's deps.json names; the wasm host's natives guard (WasmHostNatives.PINNED)
       holds the library inside each to its SHA-256.

       The solver module: the archive smt-z3-wasm.zip of the asset release smt-z3-v5.4.1 of
       this repository, the very bytes the workflow "AI Smt toolchain" builds from its pins (two
       builds compared byte for byte). It holds wasm/z3-5.4.1.wasm with Z3's licence and
       notices beside it, and is extracted at the module's root, so the module lands under wasm/
       where SmtModuleLocator looks; the controller holds it to the SHA-256 the profile pins
       (SmtProfile.MODULE_SHA256) before it compiles it. The same bytes on every platform. A
       later packing of the same solver is a release of its own (smt-z3-v5.4.1-2): a published
       archive is never replaced. -->
  <ItemGroup>
    <ControllerDataAsset Include="wasmtime-win-x64">
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/wasmtime-v48.0.8-2/wasmtime-win-x64.zip</Uri>
      <Sha256>da8365a7494f757d39d64810dea2b3eed1cb236f27bc794c9b831771b6a81e31</Sha256>
      <Size>8065827</Size>
      <ExtractTo>runtimes/win-x64/native/</ExtractTo>
    </ControllerDataAsset>
    <ControllerDataAsset Include="wasmtime-linux-x64">
      <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/wasmtime-v48.0.8-2/wasmtime-linux-x64.zip</Uri>
      <Sha256>ede145fb96677509901f31183bc558bceac92c76026071c2a969db0c6d475911</Sha256>
      <Size>9692410</Size>
      <ExtractTo>runtimes/linux-x64/native/</ExtractTo>
    </ControllerDataAsset>
    <ControllerDataAsset Include="wasmtime-osx-arm64">
      <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/wasmtime-v48.0.8-2/wasmtime-osx-arm64.zip</Uri>
      <Sha256>1f13fca2b811f16d3407cc50c3ff08a73c6781484bc32d5dfb28b433ec801012</Sha256>
      <Size>8286398</Size>
      <ExtractTo>runtimes/osx-arm64/native/</ExtractTo>
    </ControllerDataAsset>
    <ControllerDataAsset Include="smt-z3-wasm">
      <RuntimeIdentifier>any</RuntimeIdentifier>
      <Uri>gh-release://OmnibusCloud/Controllers/smt-z3-v5.4.1/smt-z3-wasm.zip</Uri>
      <Sha256>3c3f67877e4e193dc64070023fbf64addb4b01520de4b9fa79b673b77d48cc02</Sha256>
      <Size>30314801</Size>
      <ExtractTo>.</ExtractTo>
    </ControllerDataAsset>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\OutWit.Controller.AI.Smt.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.targets" />

</Project>
