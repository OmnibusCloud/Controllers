<!--
    Build/OutWit.Controller.targets
    Imported manually by each controller's main csproj after the
    OutWit.Controller.props import + the per-controller PropertyGroup.
    Provides: manifest emission, .module/ staging, .zip packing, and
    nupkg content/module/ packaging.
-->
<Project>

  <Import Project="$(MSBuildThisFileDirectory)OutWit.Controller.Manifest.targets" />

  <!-- Derived properties — computed here (rather than in OutWit.Controller.props)
       because they depend on the per-csproj <ControllerName>, which isn't set
       yet at the moment props is parsed. ToLowerInvariant matches the existing
       matrices.module / renderdcc.module / etc. naming. -->
  <PropertyGroup>
    <ControllerModuleName>$(ControllerName.ToLowerInvariant()).module</ControllerModuleName>
    <ControllerZipName>$(ControllerName.ToLowerInvariant()).zip</ControllerZipName>
    <ControllerModuleOutputDir>$(SolutionDir)@Controllers\$(Configuration)\$(ControllerModuleName)\</ControllerModuleOutputDir>
    <ControllerZipOutputDir>$(SolutionDir)@Zips\$(Configuration)\</ControllerZipOutputDir>
  </PropertyGroup>

  <!-- The build's account of what it staged (see OutWit.Controller.Staging.targets): written
       once this project's files are in the module, and the list the stamp, the zip and the
       package below are made from. -->
  <PropertyGroup>
    <ControllerStagingTarget>ControllerPostBuild</ControllerStagingTarget>
    <ControllerRecordModuleDir>$(ControllerModuleOutputDir)</ControllerRecordModuleDir>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)OutWit.Controller.Staging.targets" />

  <!-- The set of build outputs that go into a controller's .module/ folder.
       Companion Model csprojs add their own DLL via OutWit.Controller.Model.targets. -->
  <ItemGroup>
    <ControllerModuleFile Include="$(TargetDir)$(TargetName).dll" />
    <ControllerModuleFile Include="$(TargetDir)$(TargetName).dll.config" Condition="Exists('$(TargetDir)$(TargetName).dll.config')" />
    <ControllerModuleFile Include="$(TargetDir)$(TargetName).deps.json" />
    <ControllerModuleFile Include="$(TargetDir)**\$(TargetName).resources.dll" />
    <ControllerModuleFile Include="$(ControllerManifestOutputPath)" />
  </ItemGroup>

  <!-- Runtime assemblies that arrive as PACKAGES and must travel inside the
       module. A node loads a module with only the engine assemblies the host
       provides, so anything else the controller calls into has to be staged
       beside it.

       Controllers whose dependencies come from a sibling Model project need
       nothing here — that project stages its own DLL (see
       OutWit.Controller.Model.targets). This is for the other case: the two
       Simulation controllers take their numerical core from a NuGet package,
       and when that core lived here as a project it staged itself. Nothing
       does now, and a module missing it fails at load on the node rather than
       at build time — which is why the Error below exists instead of a
       best-effort copy. Set ControllerModuleAssembly to the assembly NAME,
       without extension. -->
  <Target Name="ControllerStagePackagedDependencies"
          Condition="'@(ControllerModuleAssembly)' != ''"
          BeforeTargets="ControllerPostBuild">
    <Error Condition="!Exists('$(TargetDir)%(ControllerModuleAssembly.Identity).dll')"
           Text="ControllerModuleAssembly '%(ControllerModuleAssembly.Identity)' is not in $(TargetDir). It must be next to the controller to be staged into the module — check that the package is referenced and that CopyLocalLockFileAssemblies is true for this project." />
    <ItemGroup>
      <ControllerModuleFile Include="$(TargetDir)%(ControllerModuleAssembly.Identity).dll" />
    </ItemGroup>
  </Target>

  <!-- Stages the controller's outputs into $(SolutionDir)@Controllers/<Cfg>/<name>.module/.
       Mirrors the legacy WitEngine layout so existing tooling keeps working. Nothing is
       deleted here: the folder also holds what a Model project staged and what was put there
       by hand. What this build staged goes onto ControllerStagedFile, from which the record
       is written (ControllerRecordStaged). -->
  <Target Name="ControllerPostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="@(ControllerModuleFile)"
          DestinationFolder="$(ControllerModuleOutputDir)"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />
    <ItemGroup>
      <ControllerStagedFile Include="@(ControllerModuleFile->'$(ControllerModuleOutputDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!-- Convention: any file under <ProjectDir>/Resources/ at build time gets
       staged into <module>/Resources/ with the same relative path. This is
       what makes ProjectReference-based test scenarios complete — the
       adapter's runtime resource loader can find the file at
       <assembly-dir>/Resources/<file> just like it would after a consumer
       installed the published nupkg + ran ResolveControllerAssetsTask.

       For Tier-2 controllers, the same files are also declared as
       <ControllerDataAsset> (with gh-release:// Uri) so published consumers
       fetch them from a GitHub Release rather than carrying them inline.
       Local dev / in-solution tests use this staging path; consumers use
       the asset resolver. Both end up with the same on-disk layout.

       Skipped silently when the controller has no Resources/ folder. -->
  <ItemGroup>
    <ControllerSourceResourceFile Include="$(ProjectDir)Resources\**\*"
                                  Condition="Exists('$(ProjectDir)Resources')" />
  </ItemGroup>

  <Target Name="ControllerStageSourceResources"
          AfterTargets="ControllerPostBuild"
          BeforeTargets="ControllerRecordStaged"
          Condition="@(ControllerSourceResourceFile->Count()) &gt; 0">
    <Copy SourceFiles="@(ControllerSourceResourceFile)"
          DestinationFiles="@(ControllerSourceResourceFile->'$(ControllerModuleOutputDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />
    <ItemGroup>
      <ControllerStagedFile Include="@(ControllerSourceResourceFile->'$(ControllerModuleOutputDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!-- Zips the module into $(SolutionDir)@Zips/<Cfg>/<name>.zip.
       Used by the BlobCacheService path on WitCloud server-side. Packed by our own task
       (sorted entries, fixed timestamps): the same module packed by the same build tools with
       the same build stamp gives the same bytes. Not on every machine (the compression is the
       build runtime's own, and the stamp in controller.json carries the minute of the build):
       what can be reproduced is the content digest in the manifest, for a build made as the
       publish workflow makes it (see OutWit.Controller.BuildTasks.cs), so a cloud compares
       builds by it, not by the archive.

       The archive holds the files the build's records list (ControllerRecordStaged) and what
       lies under a folder one of the controller's data assets extracts to, where a copy for
       local runs is kept. It does not hold whatever else is in the folder. -->
  <Target Name="ControllerPackZip" AfterTargets="ControllerPostBuild" DependsOnTargets="ControllerRecordStaged">
    <MakeDir Directories="$(ControllerZipOutputDir)" />
    <DeterministicZipDirectory SourceDirectory="$(ControllerModuleOutputDir)"
                               DestinationFile="$(ControllerZipOutputDir)$(ControllerZipName)"
                               Files="@(ControllerModuleStagedFile);@(ControllerModuleDataAssetFile)"
                               ListedFilesOnly="true"
                               Overwrite="true" />
  </Target>

  <!-- Packs the module into nupkg's content/module/ + writes an
       empty lib/<tfm>/_._ marker so NuGet considers the package compatible
       with consumer projects (without IncludeBuildOutput=false there'd be
       nothing in lib/ otherwise). Registered into pack via
       TargetsForTfmSpecificContentInPackage (set in OutWit.Controller.props).

       The package ships the files the build's records list (ControllerRecordStaged), not
       the folder: a file somebody left in the staged module stays on disk and is not packed. -->
  <Target Name="ControllerPackModuleContents" DependsOnTargets="ControllerPostBuild;ControllerRecordStaged;ControllerPackZip">
    <PropertyGroup>
      <_EmptyLibMarker>$(IntermediateOutputPath)_._</_EmptyLibMarker>
    </PropertyGroup>
    <WriteLinesToFile File="$(_EmptyLibMarker)" Lines="" Overwrite="true" />
    <ItemGroup>
      <!-- Resources/ is excluded from the published nupkg by convention.
           For Tier-2 controllers whose Resources/ holds external assets
           (declared as <ControllerDataAsset>) those bytes already ship via
           the matching GitHub Release and would be redundant inside the
           nupkg — duplicating them here would have ballooned Matrices'
           nupkg from 56KB to 41MB. For Tier-1 controllers (no external
           assets) Resources/ is currently empty in source so nothing
           changes. If a controller ever needs to ship inline resources,
           it should opt in explicitly via a per-csproj <None Pack="true">
           item rather than relying on the convention staging path.
           ControllerModulePackedFile is the recorded files without Resources/. -->
      <TfmSpecificPackageFile Include="@(ControllerModulePackedFile)">
        <PackagePath>content/module/%(ModulePath)</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(_EmptyLibMarker)">
        <PackagePath>lib/$(TargetFramework)/_._</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
