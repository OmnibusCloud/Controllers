<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.Scripts.props" />

  <PropertyGroup>
    <ControllerName>Schwarz</ControllerName>
    <Version>1.0.0</Version>
    <Description>Bundled .wit scripts for the OutWit.Controller.Simulation.Schwarz controller — the SchwarzSolve distributed stationary-solve job.</Description>
    <PackageTags>simulation;schwarz;scripts;domain-decomposition;witengine;witcloud;controller</PackageTags>
  </PropertyGroup>

  <!-- Compatibility marker (see docs/adr-001-script-controller-version-compatibility.md):
       the bundled scripts resolve this controller line by activity name at seed time,
       so a restore of this package proves a compatible controller exists on the feed.
       Enabled at the 1.0.0 release (2026-09-05); the controller line it binds to is
       published on nuget.org and the OmnibusCloud organization feed. -->
  <ItemGroup>
    <PackageReference Include="OutWit.Controller.Simulation.Schwarz" Version="[1.0.0, 2.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\OutWit.Controller.Simulation.Schwarz\Scripts\*.wit"
          Pack="true"
          PackagePath="content/scripts/" />

    <None Include="build\OutWit.Controller.Simulation.Schwarz.Scripts.targets"
          Pack="true"
          PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.Scripts.targets" />

</Project>
