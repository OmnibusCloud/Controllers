<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.props" />

  <PropertyGroup>
    <ControllerName>Parareal</ControllerName>
    <Version>0.1.6</Version>
    <Description>Distributed transient-problem solver (heat, diffusion) via parareal parallel-in-time integration: time slabs propagated across the pool with a fine Crank-Nicolson integrator, coarse correction server-side.</Description>
    <PackageTags>simulation;parareal;parallel-in-time;fem;fd;witengine;witcloud;controller</PackageTags>
    <ControllerFeatures>parareal-solve</ControllerFeatures>
    <ControllerUseCases>Long transient heat and diffusion runs on crowd pools</ControllerUseCases>
  </PropertyGroup>

  <ItemGroup>
    <!-- Variables only, deliberately. The bundled PararealSolve.wit also needs
         Special (Loop/If/Break/Return) and Grid (ForEach) to COMPILE, but both
         are host-only controllers that are never delivered to compute nodes,
         while this controller carries host AND node activities in one module.
         Declaring them here would make every node refuse to load the module —
         the dependency check runs node-side too. They are a server-side script
         requirement, not a module dependency; see the README. -->
    <ControllerDependency Include="Variables" MinimumVersion="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared numerical core lives in the private WitMath repository and
         is consumed as a package from that account's feed (see nuget.config).
         Building this controller therefore needs GITHUB_USER / GITHUB_TOKEN
         with read:packages; the rest of this repository builds from nuget.org
         alone. -->
    <PackageReference Include="OutWit.Math.Simulation" Version="0.2.*" />
  </ItemGroup>

  <!-- The core used to be a sibling project that staged its own DLL into this
       controller's module. As a package it stages nothing, so the module has
       to carry it explicitly — together with CSparse, the sparse factorization
       it calls into. Without this the module builds and tests fine and then
       fails to load on a node. -->
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ControllerModuleAssembly Include="OutWit.Math.Simulation" />
    <ControllerModuleAssembly Include="CSparse" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\OutWit.Controller.Simulation.Parareal.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.targets" />

</Project>
