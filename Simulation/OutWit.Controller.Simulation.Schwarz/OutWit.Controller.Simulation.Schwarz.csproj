<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Build\OutWit.Controller.props" />

  <PropertyGroup>
    <ControllerName>Schwarz</ControllerName>
    <Version>0.1.8</Version>
    <Description>Distributed stationary-problem solver (steady heat, Poisson-class fields) via overlapping Restricted Additive Schwarz domain decomposition: subdomains solved across the pool per round, boundary strips exchanged through the server.</Description>
    <PackageTags>simulation;schwarz;domain-decomposition;fem;fd;witengine;witcloud;controller</PackageTags>
    <ControllerFeatures>schwarz-solve</ControllerFeatures>
    <ControllerUseCases>Stationary heat and structural statics on LAN pools</ControllerUseCases>
  </PropertyGroup>

  <ItemGroup>
    <!-- Variables only, deliberately. The bundled SchwarzSolve.wit also needs
         Special (Loop/If/Break/Return) and Grid (ForEach) to COMPILE, but both
         are host-only controllers that are never delivered to compute nodes,
         while this controller carries host AND node activities in one module.
         Declaring them here would make every node refuse to load the module —
         the dependency check runs node-side too. They are a server-side script
         requirement, not a module dependency; see the README. -->
    <ControllerDependency Include="Variables" MinimumVersion="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared numerical core lives in the private WitMath repository and
         is consumed as a package from that account's feed (see nuget.config).
         Building this controller therefore needs GITHUB_USER / GITHUB_TOKEN
         with read:packages; the rest of this repository builds from nuget.org
         alone.

         Two packages since 0.3.0: Model is the contract (problem model, wire
         DTOs, blob format) and the other half is the numerics. A controller
         needs both. They are versioned in lockstep, so both float 0.3.*. -->
    <PackageReference Include="OutWit.Math.Simulation.Model" Version="0.3.*" />
    <PackageReference Include="OutWit.Math.Simulation" Version="0.3.*" />
  </ItemGroup>

  <!-- The core used to be a sibling project that staged its own DLL into this
       controller's module. As a package it stages nothing, so the module has
       to carry every assembly it needs explicitly — both halves of the core
       and CSparse, the sparse factorization it calls into. Without this the
       module builds and tests fine and then fails to load on a node. -->
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ControllerModuleAssembly Include="OutWit.Math.Simulation.Model" />
    <ControllerModuleAssembly Include="OutWit.Math.Simulation" />
    <ControllerModuleAssembly Include="CSparse" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\OutWit.Controller.Simulation.Schwarz.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="..\..\Build\OutWit.Controller.targets" />

</Project>
