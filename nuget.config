<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Everything in this repository restores from nuget.org, with ONE
       exception: the two Simulation controllers consume their shared
       numerical core (OutWit.Controller.Simulation.Model) as a package from
       the private OmnibusCloud feed. Building those two projects therefore
       needs GITHUB_USER and GITHUB_TOKEN set, with read:packages scope.
       Every other controller builds from a clean checkout with no
       credentials at all. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-omnibuscloud" value="https://nuget.pkg.github.com/OmnibusCloud/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-omnibuscloud">
      <package pattern="OutWit.Controller.Simulation.Model" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <github-omnibuscloud>
      <add key="Username" value="%GITHUB_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-omnibuscloud>
  </packageSourceCredentials>

</configuration>
