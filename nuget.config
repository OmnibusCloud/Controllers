<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Everything in this repository restores from nuget.org, with ONE
       exception: the two Simulation controllers consume their numerical core
       (OutWit.Math.Simulation) as a package from the private WitMath feed.
       Building those two projects therefore needs GITHUB_USER and
       GITHUB_TOKEN set, with read:packages scope. Every other controller
       builds from a clean checkout with no credentials at all.

       The core used to live in this repository and was published from it as
       OutWit.Controller.Simulation.Model. It now lives in dmitrat/WitMath,
       which is private and below this repository in the stack — this
       repository reaches down to it and nothing reaches back up. That feed
       belongs to the account, not to the OmnibusCloud organization, which is
       why the source below points at a user feed rather than an org one. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="witmath" value="https://nuget.pkg.github.com/dmitrat/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="witmath">
      <package pattern="OutWit.Math.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <witmath>
      <add key="Username" value="%GITHUB_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </witmath>
  </packageSourceCredentials>

</configuration>
